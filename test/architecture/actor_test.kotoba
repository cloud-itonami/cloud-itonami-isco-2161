(ns architecture.actor-test
  (:require [clojure.test :refer [deftest is testing]]
            [architecture.actor :as actor]
            [architecture.advisor :as advisor]
            [architecture.store :as store]))

(defn- fresh-store []
  (let [st (store/mem-store)]
    (store/register-project! st {:project-id "proj-1" :client-id "client-1" :name "Community Center"})
    st))

(deftest commits-a-clean-low-risk-design-concept
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:project-id "proj-1" :op :draft-design-concept :stake :low}
        result (actor/run-request! graph request {} "thread-1")]
    (is (= :done (:status result)))
    (is (some? (get-in result [:state :record])))
    (is (= 1 (count (store/records-of st "proj-1"))))))

(deftest holds-on-unregistered-project-without-committing
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        request {:project-id "no-such-project" :op :draft-design-concept :stake :low}
        result (actor/run-request! graph request {} "thread-2")]
    (is (= :done (:status result)))
    (is (nil? (get-in result [:state :record])))
    (is (empty? (store/records-of st "no-such-project")))
    (is (= :hold (:disposition (:state result))))))

(deftest interrupts-then-commits-on-human-approval
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        ;; code compliance flag always escalates (governor invariant)
        request {:project-id "proj-1" :op :flag-code-compliance-issue :stake :high}
        interrupted (actor/run-request! graph request {} "thread-3")]
    (is (= :interrupted (:status interrupted)))
    (is (empty? (store/records-of st "proj-1")))
    (let [resumed (actor/approve! graph "thread-3")]
      (is (= :done (:status resumed)))
      (is (some? (get-in resumed [:state :record])))
      (is (= 1 (count (store/records-of st "proj-1")))))))

(deftest holds-on-stamped-design-attempt
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        ;; attempting to issue a stamped design is a hard block
        request {:project-id "proj-1" :op :issue-stamped-design :stake :high}
        result (actor/run-request! graph request {} "thread-4")]
    (is (= :done (:status result)))
    (is (nil? (get-in result [:state :record])))
    (is (empty? (store/records-of st "proj-1")))
    (is (= :hold (:disposition (:state result))))))

(deftest end-to-end-hold-on-op-outside-the-catalog
  ;; The mock advisor passes the request's op through, as an LLM would pass
  ;; through whatever it wrote. Before architecture.operations this run
  ;; committed an :order-demolition record without any architect sign-off.
  (let [st (fresh-store)
        graph (actor/build-graph {:store st :advisor (advisor/mock-advisor)})
        result (actor/run-request! graph {:project-id "proj-1" :op :order-demolition :stake :low}
                                   {} "thread-5")]
    (is (= :done (:status result)))
    (is (empty? (store/records-of st "proj-1")))
    (is (= :hold (:disposition (last (store/ledger st)))))
    (is (= [:unknown-op]
           (mapv :rule (:violations (:verdict (last (store/ledger st)))))))))

(deftest end-to-end-commit-on-client-review
  (let [st (fresh-store)
        graph (actor/build-graph {:store st})
        result (actor/run-request! graph {:project-id "proj-1" :op :request-client-review :stake :low}
                                   {} "thread-6")]
    (is (= :done (:status result)))
    (is (= [:request-client-review] (mapv :op (store/records-of st "proj-1"))))))
