(ns architecture.operations
  "The closed vocabulary of design operations this actor may propose.

  Before this catalog the governor judged a proposal by its project, its
  `:effect`, the two stamping ops it names, its confidence and its
  life-safety tags — and accepted every other `:op` it had never heard of.
  The advisor is swappable and `llm-advisor` passes through whatever `:op`
  the model wrote, so `{:op :order-demolition :effect :propose :confidence
  0.9}` for a registered project came back `:ok? true` and was committed as
  a design record with no architect sign-off. This is the allow-list the
  governor now checks against.

  Three kinds of op:
    permitted  — may be proposed; the governor still applies its other rules.
    forbidden  — the licensed architect's exclusive professional acts. The
                 governor holds them under their own rule (`:no-stamping`),
                 so the verdict says why rather than only that the op is
                 unfamiliar.
    anything else — unknown, and a hard `:unknown-op` block. That includes
                 `:unknown`, which `advisor/parse-proposal` emits when the
                 model's reply could not be read: there is no proposal to
                 approve, so it holds rather than asking the architect to
                 sign off on nothing.")

(def permitted
  "Ops the advisor may propose, with what each one produces."
  {:draft-design-concept       "a design concept for the architect's review"
   :prepare-specification      "a draft material / system specification"
   :flag-code-compliance-issue "a building-code concern for the architect to assess (always escalates)"
   :request-client-review      "a client review request for the current design package"})

(def forbidden
  "Ops only the licensed architect may perform. Never proposed, never automated."
  #{:issue-stamped-design :certify-code-compliance})

(defn permitted? [op] (contains? permitted op))

(defn forbidden? [op] (contains? forbidden op))

(defn unknown?
  "True for an op the catalog neither permits nor names as forbidden."
  [op]
  (not (or (permitted? op) (forbidden? op))))
